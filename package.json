{
    "name": "tomato-downloader",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build -w apps/backend && npm run build -w apps/frontend",
        "dev": "npm-run-all --parallel dev:backend dev:frontend",
        "dev:backend": "npm run dev -w apps/backend",
        "dev:frontend": "npm run dev -w apps/frontend",
        "db:migrate": "node scripts/migrate-storage-to-db.mjs",
        "legacy:copy": "node scripts/copy-legacy.mjs",
        "legacy:start": "node --env-file-if-exists=.env scripts/start-legacy-webui.mjs",
        "load:bench": "node tests/load/autocannon.mjs",
        "test": "npm run test -w apps/backend",
        "test:load": "node tests/load/smoke.mjs",
        "backup": "node scripts/backup.mjs",
        "start": "npm run start -w apps/backend"
    },
    "workspaces": [
        "apps/backend",
        "apps/frontend"
    ],
    "devDependencies": {
        "autocannon": "^8.0.0",
        "npm-run-all": "^4.1.5"
    },
    "optionalDependencies": {
        "@esbuild/win32-x64": "0.27.7"
    },
    "engines": {
        "node": ">=20.11.0"
    }
}
