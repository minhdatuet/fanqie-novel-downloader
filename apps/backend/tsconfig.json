{
    "compilerOptions": {
        "declaration": false,
        "esModuleInterop": true,
        "lib": [
            "ES2023",
            "DOM"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noUncheckedIndexedAccess": true,
        "outDir": "dist",
        "resolveJsonModule": true,
        "rootDir": "src",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023"
    },
    "include": [
        "src/**/*.ts"
    ]
}
