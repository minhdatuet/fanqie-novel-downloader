        "start": "node --env-file-if-exists=.env --env-file-if-exists=../../.env dist/server.js"
    },
    "dependencies": {
        "@fastify/cors": "^10.0.1",
        "@fastify/static": "^9.1.3",
        "fastify": "^5.1.0",
        "jszip": "^3.10.1"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "vitest": "^2.1.9",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
