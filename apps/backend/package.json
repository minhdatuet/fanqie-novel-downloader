{
    "name": "@tomato-downloader/backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
